      "parameters": {
        "jsCode": "const publications = $input.all().map(({json:r})=>({source_id:r.source_id,video_id:r.video_id,title:r.title,published_at:r.published_at,summary:r.summary||''})).filter(r=>Number.isFinite(Date.parse(r.published_at))); publications.sort((a,b)=>Date.parse(b.published_at)-Date.parse(a.published_at)||a.source_id.localeCompare(b.source_id)||a.video_id.localeCompare(b.video_id)); const counts=new Map(); const active=publications.filter(r=>{const count=counts.get(r.source_id)||0;if(count>=2)return false;counts.set(r.source_id,count+1);return true;}); return [{json:{version:1,publications:active}}];"
