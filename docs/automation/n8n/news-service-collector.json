      "parameters": {
        "jsCode": "return $input.all().flatMap((item, i) => {\n  let source;\n  try { source = $('Code in JavaScript').itemMatching(i)?.json; } catch {}\n  if (!source) { try { source = $('Code in JavaScript3').itemMatching(i)?.json; } catch {} }\n  const source_id = source?.source_id;\n  const video_id = String(item.json?.id || '').replace(/^yt:video:/, '');\n  const published_at = item.json?.isoDate;\n  if (!/^UC[A-Za-z0-9_-]{22}$/.test(source_id || '') || !/^[A-Za-z0-9_-]{11}$/.test(video_id) || !item.json?.title || !published_at) return [];\n  return [{json:{source_id, video_id, title:item.json.title, published_at, summary:'', creator:source.creator || source.source_id, destination:source.destination, enabled:source.enabled === true, discord_channel_id:source.discord_channel_id, checkpoint_video_id:source.checkpoint_video_id, checkpoint_published_at:source.checkpoint_published_at, stage3_activated_at:source.stage3_activated_at, original_url:`https://www.youtube.com/watch?v=${video_id}`, image_url:`https://i.ytimg.com/vi/${video_id}/hqdefault.jpg`}}];\n});"
