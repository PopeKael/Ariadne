    {
      "parameters": {
        "jsCode": "const publicationIds = $('Aggregate Existing Publication IDs').first()?.json?.publication_ids || [];\nconst deliveryHistory = $input.all().flatMap(({json:r}) => {\n  if (typeof r?.state_json !== 'string' || typeof r?.delivery_key !== 'string') return [];\n  try { const value = JSON.parse(r.state_json.replace(/^=/, '')); return value && typeof value === 'object' ? [value] : []; } catch { return []; }\n});\nconst publicationHistory=deliveryHistory.find(x=>x.delivery_key==='__system_publication_history__');\nconst activationKey='__system_stage4_activation__';\nconst priorActivation=deliveryHistory.find(x=>x.delivery_key===activationKey && typeof x.stage4_activated_at==='string');\nconst stage4_activated_at=priorActivation?.stage4_activated_at || new Date().toISOString();\nconst activationState={delivery_key:activationKey,stage4_activated_at};\nreturn [{json:{publication_ids:[...new Set([...publicationIds,...(publicationHistory?.video_ids||[])])],delivery_history:deliveryHistory.filter(x=>!['__system_stage4_activation__','__system_publication_history__'].includes(x.delivery_key)),stage4_activated_at,activation_key:activationKey,activation_state_json:JSON.stringify(activationState)}}];"
      },
      "id": "0b640963-79da-4f46-b2db-0bb16f09c89f",
