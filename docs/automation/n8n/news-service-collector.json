    {
      "parameters": {
        "jsCode": "const ids = [...new Set($input.all().map(x => x.json?.video_id).filter(x => typeof x === 'string' && /^[A-Za-z0-9_-]{11}$/.test(x)))];\nreturn [{json:{publication_ids:ids}}];"
      },
      "id": "7c5b8d8d-58a9-4e50-bad7-cff03f131f6c",
      "name": "Aggregate Existing Publication IDs",
