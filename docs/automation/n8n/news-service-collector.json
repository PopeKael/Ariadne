    {
      "parameters": {
        "jsCode": "return $input.all().flatMap((item, i) => {\n  const source_id = $('Code in JavaScript').itemMatching(i)?.json?.source_id;\n  const video_id = String(item.json?.id || '').replace(/^yt:video:/, '');\n  if (!/^UC[A-Za-z0-9_-]{22}$/.test(source_id || '') || !/^[A-Za-z0-9_-]{11}$/.test(video_id) || !item.json?.title || !item.json?.isoDate) return [];\n  return [{json:{source_id, video_id, title:item.json.title, published_at:item.json.isoDate, summary:''}}];\n});"
      },
