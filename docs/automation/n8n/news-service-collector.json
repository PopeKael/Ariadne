        "jsCode": "const all=$('Code in JavaScript1').all().map(({json})=>({source_id:json.source_id,video_id:json.video_id,title:json.title,published_at:json.published_at,summary:json.summary||''})).filter(r=>Number.isFinite(Date.parse(r.published_at)));\nconst bySource=new Map(); for(const row of all){const list=bySource.get(row.source_id)||[];list.push(row);bySource.set(row.source_id,list)}\nconst rows=[]; for(const list of bySource.values()){list.sort((a,b)=>Date.parse(b.published_at)-Date.parse(a.published_at)||b.video_id.localeCompare(a.video_id));rows.push(...list.slice(0,2))}\nrows.sort((a,b)=>Date.parse(b.published_at)-Date.parse(a.published_at)||a.source_id.localeCompare(b.source_id)||b.video_id.localeCompare(a.video_id));\nconst delivery_history=$('Prepare Registry Context').first()?.json?.delivery_history||[];\nreturn [{json:{version:1,publications:rows,delivery_history}}];"
