        "jsCode": "const snapshot = $input.first()?.json;\nif (snapshot?.version !== 1 || !Array.isArray(snapshot.sources)) throw new Error('Ariadne registry snapshot was invalid');\nconst sources = snapshot.sources.filter(source => typeof source.id === 'string' && typeof source.video_id === 'string' && typeof source.published_at === 'string');\nreturn sources.map(source => ({json:{source_id:source.id}}));"
