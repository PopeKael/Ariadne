        "jsCode": "const rows=$input.all().map(({json})=>({source_id:json.source_id,video_id:json.video_id,title:json.title,published_at:json.published_at,summary:json.summary||''})).filter(r=>Number.isFinite(Date.parse(r.published_at))); rows.sort((a,b)=>Date.parse(b.published_at)-Date.parse(a.published_at)||a.source_id.localeCompare(b.source_id)||a.video_id.localeCompare(b.video_id)); return [{json:{version:1,publications:rows}}];"
