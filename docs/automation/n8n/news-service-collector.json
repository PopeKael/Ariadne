        "jsCode": "const candidate=$('Prepare Discord Candidates').itemMatching($itemIndex)?.json || $('Prepare Discord Candidates').all()[$itemIndex]?.json || {};\nconst response=$json?.body && typeof $json.body === 'object' ? $json.body : $json;\nconst status=Number($json?.statusCode || $json?.status || (response?.id ? 200 : 0));\nconst finished_at=new Date().toISOString();\nlet result='uncertain', retry_after=null;\nif(status >= 200 && status < 300 && response?.id) result='sent';\nelse if(status === 429) { result='rate_limited'; const seconds=Number(response?.retry_after || 1); retry_after=Date.now()/1000 + (Number.isFinite(seconds) ? Math.max(1,seconds) : 1); }\nelse if(status >= 400 && status < 500) result='rejected';\nconst state={delivery_key:candidate.delivery_key,delivery_id:`${candidate.delivery_key}#${candidate.attempt}`,video_id:candidate.video_id,destination:candidate.destination,discord_channel_id:String(candidate.discord_channel_id),status:result,attempts:candidate.attempt,started_at:candidate.started_at,finished_at,http_status:status || null,discord_message_id:response?.id ? String(response.id) : null,discord_timestamp:response?.timestamp || null,retry_after};\nreturn {json:{delivery_key:candidate.delivery_key,state_json:JSON.stringify(state)}};"
