      "parameters": {
        "jsCode": "const prior=$('Get Existing Publications').all().map(x=>x.json).filter(x=>x?.video_id && x?.source_id);\nconst current=$('Prepare Active Publication Window').all().map(x=>x.json).filter(x=>x?.video_id && x?.source_id);\nconst collected=$('Code in JavaScript1').all().map(x=>x.json).filter(x=>x?.video_id && x?.source_id);\nconst context=$('Prepare Registry Context').first()?.json||{};\nconst unresolved=new Set((context.delivery_history||[]).filter(x=>['inflight','uncertain','pending','rate_limited','rejected'].includes(x.status)).map(x=>x.video_id));\nconst byId=new Map(); for(const x of [...prior,...current]) { const old=byId.get(x.video_id); if(!old || Date.parse(x.published_at)>Date.parse(old.published_at)) byId.set(x.video_id,x); }\nconst bySource=new Map(); for(const x of byId.values()){const a=bySource.get(x.source_id)||[];a.push(x);bySource.set(x.source_id,a)}\nconst keep=new Set(); for(const rows of bySource.values()){ rows.sort((a,b)=>Date.parse(b.published_at)-Date.parse(a.published_at)||b.video_id.localeCompare(a.video_id)); for(const x of rows.slice(0,2)) keep.add(x.video_id); }\nconst stale=[...new Set([...byId.values()].filter(x=>!keep.has(x.video_id)&&!unresolved.has(x.video_id)).map(x=>x.video_id))];\nconst video_ids=[...new Set([...(context.publication_ids||[]),...prior.map(x=>x.video_id),...collected.map(x=>x.video_id)])];\nreturn [{json:{stale_video_ids:stale,video_ids}}];"
      },
