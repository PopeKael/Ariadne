    {
      "parameters": {
        "jsCode": "const row = $input.all().map(item => item.json).find(value => value.source_id === '__registry__' && typeof value.state_json === 'string');\nif (!row) throw new Error('No last-known source registry is available');\nconst snapshot = JSON.parse(row.state_json.replace(/^=/, ''));\nif (snapshot?.version !== 1 || !Array.isArray(snapshot.sources) || typeof snapshot.stage3_activated_at !== 'string') throw new Error('Cached source registry is invalid');\nreturn snapshot.sources\n  .filter(source => source.enabled === true && typeof source.id === 'string' && typeof source.video_id === 'string' && typeof source.published_at === 'string')\n  .map(source => ({json:{source_id:source.id, destination:source.destination, enabled:true, creator:source.friendly_name || source.name, discord_channel_id:source.discord_channel_id, checkpoint_video_id:source.video_id, checkpoint_published_at:source.published_at, stage3_activated_at:snapshot.stage3_activated_at}}));"
      },
