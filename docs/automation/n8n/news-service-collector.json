    {
      "parameters": {
        "jsCode": "const context = $('Prepare Registry Context').first()?.json || {};\nconst activationMs = Date.parse(context.stage4_activated_at);\nconst existing = new Set(context.publication_ids || []);\nconst history = new Map();\nfor (const record of context.delivery_history || []) { if (!record || typeof record.delivery_key !== 'string') continue; const old=history.get(record.delivery_key); if (!old || Number(record.attempts||0)>=Number(old.attempts||0)) history.set(record.delivery_key,record); }\nconst sentVideoIds = new Set((context.delivery_history || []).filter(x => x.status === 'sent' && x.video_id).map(x => x.video_id));\nconst escape = value => String(value ?? '').replace(/[\\u0000-\\u001f\\u007f]/g,' ').replace(/\\s+/g,' ').trim().replace(/[\\\\`*_~|\\[\\]<>]/g,'\\\\$&');\nconst out=[];\nfor (const item of $('Code in JavaScript1').all().map(x=>x.json)) {\n  if (item.enabled !== true || !item.source_id || !item.destination || !/^\\d{15,22}$/.test(String(item.discord_channel_id || ''))) continue;\n  const published=Date.parse(item.published_at), activation=Date.parse(item.stage3_activated_at), checkpoint=Date.parse(item.checkpoint_published_at);\n  if (!Number.isFinite(activationMs) || !Number.isFinite(published) || !Number.isFinite(activation) || !Number.isFinite(checkpoint) || published <= activationMs || published <= activation || published <= checkpoint) continue;\n  if (sentVideoIds.has(item.video_id)) continue;\n  const delivery_key=`${item.video_id}:${item.destination}:${item.discord_channel_id}`;\n  const prior=history.get(delivery_key);\n  if (prior && ['sent','inflight','uncertain','rejected','pending'].includes(prior.status)) continue;\n  const attempts=Number(prior?.attempts || 0);\n  if (prior?.status === 'rate_limited' && (attempts >= 3 || Number(prior.retry_after || 0) > Date.now()/1000)) continue;\n  if (!prior && existing.has(item.video_id) && published <= activationMs) continue;\n  const components=[];\n  if (/^https:\\/\\/i\\.ytimg\\.com\\//.test(item.image_url || '')) components.push({type:12,items:[{media:{url:item.image_url}}]});\n  components.push({type:10,content:`**${escape(item.title).slice(0,300)}**`},{type:10,content:`By ${escape(item.creator).slice(0,200)}`});\n  const summary=escape(item.summary).slice(0,420); if(summary) components.push({type:10,content:summary});\n  components.push({type:10,content:item.original_url});\n  const started_at=new Date().toISOString(), attempt=attempts+1;\n  const payload={flags:32768,allowed_mentions:{parse:[]},components};\n  const state={delivery_key,delivery_id:`${delivery_key}#${attempt}`,video_id:item.video_id,destination:item.destination,discord_channel_id:String(item.discord_channel_id),status:'inflight',attempts:attempt,started_at,finished_at:null,http_status:null,discord_message_id:null,discord_timestamp:null,retry_after:null};\n  out.push({json:{...item,delivery_key,dry_run:$execution.mode !== 'production',attempt,payload,state_json:JSON.stringify(state),started_at}});\n}\nreturn out;"
      },
