{
  "manifest_version": "0.1",
  "plugin_id": "cleanup",
  "name": "Cleanup",
  "version": "1.0.0",
  "description": "Configurable local Downloads and document organisation.",
  "author": "Ariadne Core",
  "plugin_type": "capability",
  "capabilities": ["filesystem.organise"],
  "actions": ["preview", "apply"],
  "action_metadata": {"preview": {"schedulable": true, "mutating": false}, "apply": {"schedulable": true, "mutating": true}},
  "entry_point": "cleanup:build_command",
  "ui": {"available": false, "route": null},
  "settings": {"available": true, "route": "/configuration", "label": "Configure Cleanup"},
  "permissions": ["filesystem.read", "filesystem.move"],
  "dependencies": [],
  "hardware_requirements": {},
  "resource_requirements": {"execution": "on_demand"},
  "startup": "on_demand",
  "enabled": true,
  "health": {"state": "healthy", "detail": "Existing Downloads organiser adapter is available."},
  "activity": {"supported": true, "transport": "ariadne-core", "progress": true}
}
