{
  "manifest_version": "0.1",
  "plugin_id": "qwen-code",
  "name": "Qwen Code",
  "version": "1.0.0",
  "description": "General local coding capability routed through Ariadne's Rust Host resource custodian.",
  "author": "Ariadne Core",
  "plugin_type": "capability",
  "capabilities": ["coding.execute", "coding.inspect", "coding.verify"],
  "entry_point": "",
  "ui": {"available": false, "route": null},
  "settings": {"available": false, "route": null},
