  "dependencies": [],
  "hardware_requirements": {"gpu_admission": "Ariadne Rust Host"},
  "resource_requirements": {"execution": "on_demand", "workspace_root": "F:\\AriadneLab\\agent-workspaces"},
  "startup": "on_demand",
  "enabled": true,
  "health": {"state": "healthy", "detail": "Uses the installed Qwen Code launcher and Ariadne Rust Host model leases."},
  "activity": {"supported": true, "transport": "ariadne-core", "progress": true}
}
